# I.S.E.F. San Luis — cabeceras de Cloudflare (Workers, archivos estáticos)
# HTML y datos: Cloudflare ya manda "max-age=0, must-revalidate" + ETag (siempre revalida).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Archivos con hash: caché de 1 año
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Imágenes y documentos: 1 semana
/media/*
  Cache-Control: public, max-age=604800
/docs/*
  Cache-Control: public, max-age=604800

# Vistas previas (*.workers.dev): fuera de Google, solo cuenta isefsanluis.net
https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
