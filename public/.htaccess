# ─────────────────────────────────────────────────────────────
# I.S.E.F. San Luis — Apache (sitio estático prerenderizado)
# SIN USO: producción es Cloudflare Pages (public/_redirects y _headers).
# ─────────────────────────────────────────────────────────────
Options -Indexes -MultiViews
DirectorySlash Off
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forzar HTTPS y dominio sin www
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

  # URLs del sitio anterior (301 permanentes, conservan el posicionamiento)
  RewriteRule ^Carrera/?$ /carrera [R=301,L]
  RewriteRule ^Inscripciones/?$ /inscripciones [R=301,L]
  RewriteRule ^Especializaciones/?$ /especializaciones [R=301,L]
  RewriteRule ^Aranceles/?$ /aranceles [R=301,L]
  RewriteRule ^Noticias/?$ /novedades [R=301,L]
  RewriteRule ^Cookies/?$ /privacidad [R=301,L]
  RewriteRule ^Institucional/Contacto/?$ /contacto [R=301,L]
  RewriteRule ^Institucional/Historia/?$ /carrera [R=301,L]
  RewriteRule ^Institucional/?$ /contacto [R=301,L]
  RewriteRule ^TestHiit/?$ /test-hiit [R=301,L]
  RewriteRule ^cvGatto\.pdf$ /disertantes/agustina-gatto [R=301,L]

  # Quitar barra final (excepto la raíz)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # /ruta → /ruta.html (páginas prerenderizadas)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)$ /$1.html [L]

  # Páginas solo-cliente con subrutas (panel de administración)
  RewriteRule ^admin/.+$ /admin.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Archivos con hash: caché de 1 año. HTML: siempre revalidar.
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpg|jpeg|svg|ico|pdf|docx?)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(html|htm|xml|txt|json|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>

AddType application/manifest+json .webmanifest
